<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Q2 Employee Dashboard</title>
  <style>
    body{font-family:Arial;padding:20px}
    table{width:100%;border-collapse:collapse}
    td,th{padding:8px;border-bottom:1px solid #eee}
    .toggle{cursor:pointer;padding:6px 12px;border-radius:16px;border:1px solid #ccc;display:inline-block}
    .active{background:#c8f7c5}
    .inactive{background:#f7c5c5}
    #msg{margin-top:10px;color:red}
  </style>
</head>
<body>
  <h2>Employees</h2>
  <table id="empTable">
    <thead><tr><th>Name</th><th>Status</th><th>Toggle</th></tr></thead>
    <tbody></tbody>
  </table>
  <div id="msg"></div>

  <script>
    var tbody = document.querySelector('#empTable tbody');
    var msg = document.getElementById('msg');

    function showMsg(t) {
      msg.textContent = t;
      setTimeout(function(){ msg.textContent = ''; }, 3000);
    }

    function fetchEmployees() {
      var xhr = new XMLHttpRequest();
      xhr.open('GET','http://localhost:3002/employees',true);
      xhr.onload = function(){
        if (xhr.status >= 200 && xhr.status < 300) {
          var data = JSON.parse(xhr.responseText);
          render(data);
        } else {
          showMsg('Failed to load employees');
        }
      };
      xhr.onerror = function(){ showMsg('Network error'); };
      xhr.send();
    }

    function render(list) {
      tbody.innerHTML = '';
      list.forEach(function(emp){
        var tr = document.createElement('tr');
        tr.innerHTML = '<td>'+emp.name+'</td><td class="stat">'+emp.status+'</td><td></td>';
        var tdToggle = tr.querySelector('td:last-child');
        var btn = document.createElement('button');
        btn.className = 'toggle ' + (emp.status==='active' ? 'active' : 'inactive');
        btn.textContent = emp.status === 'active' ? 'Active' : 'Inactive';
        btn.onclick = function(){
          toggleStatus(emp, btn, tr);
        };
        tdToggle.appendChild(btn);
        tbody.appendChild(tr);
      });
    }

    function toggleStatus(emp, btn, row) {
      var old = emp.status;
      var newStatus = old === 'active' ? 'inactive' : 'active';

      // Immediate UI update (optimistic)
      emp.status = newStatus;
      btn.className = 'toggle ' + (newStatus==='active'?'active':'inactive');
      btn.textContent = newStatus === 'active' ? 'Active' : 'Inactive';
      row.querySelector('.stat').textContent = newStatus;

      var xhr = new XMLHttpRequest();
      xhr.open('PATCH', 'http://localhost:3002/employees/' + emp.id, true);
      xhr.setRequestHeader('Content-Type', 'application/json;charset=UTF-8');
      xhr.onload = function() {
        if (!(xhr.status >= 200 && xhr.status < 300)) {
          // revert
          emp.status = old;
          btn.className = 'toggle ' + (old==='active'?'active':'inactive');
          btn.textContent = old === 'active' ? 'Active' : 'Inactive';
          row.querySelector('.stat').textContent = old;
          showMsg('Failed to update status, reverted.');
        }
      };
      xhr.onerror = function() {
        emp.status = old;
        btn.className = 'toggle ' + (old==='active'?'active':'inactive');
        btn.textContent = old === 'active' ? 'Active' : 'Inactive';
        row.querySelector('.stat').textContent = old;
        showMsg('Network error, reverted.');
      };
      xhr.send(JSON.stringify({ status: newStatus }));
    }

    fetchEmployees();
  </script>
</body>
</html>
